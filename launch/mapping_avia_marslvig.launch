<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find voxel_pillar)/config/MARS_LVIG.yaml" />

	<node pkg="voxel_pillar" type="voxelpillar_mapping" name="laserMapping" output="screen" />

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find voxel_pillar)/rviz_cfg/M300.rviz" />
	</group>

	<!-- For debugging, add launch-prefix to the mapping node above:
	     launch-prefix="gdb"
	     launch-prefix="valgrind"
	     (full commands: see CLAUDE.md "Debugging") -->
</launch> 	
