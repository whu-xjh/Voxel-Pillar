<launch>
<!-- Launch file for merged Livox LiDAR (159, 160, 161) and Voxel-Pillar mapping -->

	<arg name="rviz" default="true" />

	<!-- LiDAR topic merger node -->
	<node pkg="voxel_pillar" type="merge_lidar" name="merge_lidar" output="screen">
		<param name="output_topic" value="/livox/multi_lidar" />
		<param name="input_topic_159" value="/livox/lidar_192_168_1_159" />
		<param name="input_topic_160" value="/livox/lidar_192_168_1_160" />
		<param name="input_topic_161" value="/livox/lidar_192_168_1_161" />
	</node>

	<!-- Load merged LiDAR configuration -->
	<rosparam command="load" file="$(find voxel_pillar)/config/merge_lidar.yaml" />

	<!-- Voxel-Pillar mapping node -->
	<node pkg="voxel_pillar" type="voxelpillar_mapping" name="laserMapping" output="screen" />

	<group if="$(arg rviz)">
		<!-- RViz with robot follow view -->
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find voxel_pillar)/rviz_cfg/merge_lidar.rviz" />
	</group>

	<!-- For debugging, add launch-prefix to the mapping node above:
	     launch-prefix="gdb"
	     launch-prefix="valgrind"
	     (full commands: see CLAUDE.md "Debugging") -->
</launch>
