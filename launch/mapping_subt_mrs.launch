<launch>
<!-- Launch file for SubT_MRS dataset-->

	<arg name="rviz" default="false" />

	<rosparam command="load" file="$(find voxel_pillar)/config/SubT_MRS.yaml" />
	<node pkg="voxel_pillar" type="voxelpillar_mapping" name="laserMapping" output="screen" />

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find voxel_pillar)/rviz_cfg/voxel_pillar.rviz" />
	</group>

    

	<!-- For debugging, add launch-prefix to the mapping node above:
	     launch-prefix="gdb"
	     launch-prefix="valgrind"
	     (full commands: see CLAUDE.md "Debugging") -->
</launch> 	
